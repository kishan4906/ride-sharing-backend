# ─── Server ─────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ─── Database (PostgreSQL via Prisma) ──────────────────────────────────────
# When running via docker-compose, host is "postgres" (the service name).
# When running the app locally against dockerized Postgres, use "localhost".
DATABASE_URL="postgresql://ride_user:ride_pass@localhost:5432/ride_sharing?schema=public"

# ─── Redis ──────────────────────────────────────────────────────────────────
# Used for: driver geolocation (GEO commands), ride-matching locks,
# rate limiting, and as the BullMQ job queue backend.
REDIS_URL="redis://localhost:6379"

# ─── Auth ───────────────────────────────────────────────────────────────────
JWT_SECRET="dev_only_change_me_in_production_please"
JWT_EXPIRES_IN="7d"

# ─── Matching / Fare tuning ─────────────────────────────────────────────────
MATCHING_SEARCH_RADIUS_KM=5
MATCHING_MAX_CANDIDATES=10
FARE_BASE=40
FARE_PER_KM=12
FARE_PER_MINUTE=1.5
FARE_MINIMUM=60
AVERAGE_SPEED_KMPH=25

# ─── Rate limiting ──────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
LOCATION_UPDATE_MIN_INTERVAL_MS=2000

# ─── CORS ───────────────────────────────────────────────────────────────────
CORS_ORIGIN="*"

# ─── Logging ────────────────────────────────────────────────────────────────
LOG_LEVEL=info
